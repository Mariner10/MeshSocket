# MeshSocket relay image (see docker-compose.yml / test.sh).
#
# Runs as a non-root user with pinned dependencies. The compose file mounts
# ./Python at /app/lib read-only and sets PYTHONPATH=/app, so the server is
# started as lib/socket_server.py and the same image doubles as the echo client.
FROM python:3.12-slim

# Pinned to the versions the 0.2.0 test suite ran against; bump deliberately.
RUN pip install --no-cache-dir \
        websockets==17.1 \
        certifi==2026.7.22

# Non-root, no shell, no home: the relay needs nothing on the filesystem.
RUN groupadd --system --gid 65532 mesh \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin mesh

WORKDIR /app
COPY --chown=65532:65532 Python/socketCore.py Python/socket_server.py /app/lib/
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

USER 65532:65532
EXPOSE 8765

# The relay accepts TCP on 8765 when healthy; anything else (crash, hung loop
# that no longer accepts) fails the probe.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import socket,sys; s=socket.create_connection(('127.0.0.1', 8765), timeout=2); s.close()"]

CMD ["python", "-u", "lib/socket_server.py"]
